<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Resolve the default language before React or a cached app shell runs.
  RewriteRule ^$ /es [R=302,L]

  # Keep one canonical URL for language home pages.
  RewriteRule ^(es|en)/$ /$1 [R=302,L]

  # Serve existing files and directories normally.
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Let React Router resolve every client-side route.
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Public files may keep stable names, so use a conservative browser cache.
  <FilesMatch "\.(?:css|js|woff2?|png|jpe?g|gif|webp|svg|ico)$">
    Header always set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # Vite build assets include a content hash and can be cached permanently.
  <IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/assets/" rium_versioned_asset
    Header always set Cache-Control "public, max-age=31536000, immutable" env=rium_versioned_asset
  </IfModule>

  # HTML must always be revalidated so it never references obsolete chunks.
  <Files "index.html">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>

  # The service worker must update immediately after each deployment.
  <Files "sw.js">
    Header always set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>
</IfModule>
